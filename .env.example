# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://user:password@host:5432/subscriptiq?schema=public
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Odoo instance (Odoo 14+ supports API keys: set ODOO_PASSWORD to the API key)
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=integration@example.com
ODOO_PASSWORD=your-api-key-or-password
ODOO_TIMEOUT_MS=20000

# Scheduled billing job (/api/cron/billing). Minimum 16 characters.
# The route refuses to run when this is unset.
CRON_SECRET=replace-with-a-long-random-string

# Optional outbound email for notifications. Both values are required to send;
# without them the application keeps working with in-app notifications only.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=billing@brightloop.example
