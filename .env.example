# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/subscriptiq?schema=public"
AUTH_SECRET="generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))""
AUTH_TRUST_HOST="true"

# Odoo instance (Odoo 14+ supports API keys: set ODOO_PASSWORD to the API key)
ODOO_URL="https://your-instance.odoo.com"
ODOO_DB="your-db-name"
ODOO_USERNAME="integration@brightloop.example"
ODOO_PASSWORD=""
ODOO_TIMEOUT_MS="20000"
